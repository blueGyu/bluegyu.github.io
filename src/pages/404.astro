---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found">
  <section class="space-y-4">
    <h1 class="text-3xl font-semibold tracking-tight">Page not found</h1>
    <p class="text-zinc-600 dark:text-zinc-400">
      The page you are looking for does not exist. Double-check the URL or return to the homepage.
    </p>
    <a
      class="inline-flex items-center justify-center rounded-full border border-zinc-200 bg-white/70 px-4 py-2 text-sm font-semibold text-zinc-600 transition hover:border-zinc-300 hover:text-zinc-900 dark:border-zinc-700 dark:bg-transparent dark:text-zinc-200 dark:hover:border-zinc-400"
      href="/"
    >
      Back home
    </a>
  </section>
</BaseLayout>
