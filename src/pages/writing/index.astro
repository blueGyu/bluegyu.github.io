---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllPosts } from "../../lib/markdown";

const posts = getAllPosts();
---

<BaseLayout title="Writing">
  <section class="space-y-8">
    <div class="space-y-3">
      <h1 class="text-3xl font-semibold tracking-tight">Writing</h1>
      <p class="max-w-2xl text-zinc-600 dark:text-zinc-400">
        Notes, essays, and learnings from
        <span class="font-medium text-zinc-800 dark:text-zinc-200">content/posts</span>.
      </p>
    </div>

    {posts.length === 0 ? (
      <div class="rounded-2xl border border-dashed border-zinc-200 bg-white/60 p-8 text-center text-sm text-zinc-500 dark:border-zinc-700 dark:bg-transparent dark:text-zinc-400">
        아직 글이 없습니다. Markdown을 추가해 첫 번째 글을 발행해 보세요.
      </div>
    ) : (
      <div class="space-y-4">
        {posts.map((post) => (
          <a
            href={`/writing/${post.slug}`}
            class="group flex flex-col gap-2 rounded-2xl border border-zinc-200/60 bg-white/60 p-6 shadow-sm shadow-zinc-200/40 transition hover:-translate-y-1 hover:border-zinc-300 hover:shadow-md dark:border-zinc-800 dark:bg-transparent dark:shadow-none dark:hover:border-zinc-700"
          >
            <div class="text-xs uppercase tracking-[0.2em] text-zinc-500">{post.date}</div>
            <h2 class="text-lg font-semibold group-hover:text-zinc-700 dark:group-hover:text-zinc-200">
              {post.title}
            </h2>
            {post.summary ? (
              <p class="text-sm text-zinc-600 dark:text-zinc-400">{post.summary}</p>
            ) : null}
            {post.tags?.length ? (
              <div class="flex flex-wrap gap-2 text-xs text-zinc-500">
                {post.tags.map((tag) => (
                  <span class="rounded-full border border-zinc-200 px-2 py-1 dark:border-zinc-700">
                    {tag}
                  </span>
                ))}
              </div>
            ) : null}
          </a>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
