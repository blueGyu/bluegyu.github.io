---
const { eyebrow, title, subtitle } = Astro.props;
---

<div class="space-y-3">
  {eyebrow ? (
    <p class="text-xs font-semibold uppercase tracking-[0.3em] text-zinc-500">{eyebrow}</p>
  ) : null}
  <h2 class="text-2xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100 sm:text-3xl">
    {title}
  </h2>
  {subtitle ? (
    <p class="max-w-2xl text-base text-zinc-600 dark:text-zinc-400">{subtitle}</p>
  ) : null}
</div>
